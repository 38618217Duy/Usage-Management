{
  "name": "cursor-usage-automation",
  "version": "1.0.0",
  "description": "Automation tool to download CSV usage from Cursor for multiple accounts using persistent browser profiles",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "sync:check": "node scripts/sync-accounts.js --dry-run",
    "sync:run": "node scripts/sync-accounts.js"
  },
  "keywords": [
    "cursor",
    "automation",
    "playwright",
    "usage",
    "csv"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "express": "^4.18.2",
    "playwright": "^1.40.0",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
